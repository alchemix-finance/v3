RPC_URL=https://ethereum-rpc.publicnode.com
CHAIN_ID=1
ALCHEMIST_ADDRESS=0x0000000000000000000000000000000000000000

# Required in execute mode. The keeper halts if the proxy implementation changes.
EXPECTED_IMPLEMENTATION=0x0000000000000000000000000000000000000000
ACCOUNT_MAPPING_SLOT=33

# Human-readable debt-token units and basis points.
MIN_STALE_REDEEMED_DEBT=25000
MAX_REMAINING_DEBT_BPS=1000
MAX_POKES_PER_SCAN=3

POLL_INTERVAL_MS=15000
CONFIRMATIONS=2
RPC_CONCURRENCY=12
RPC_RETRIES=4
RPC_RETRY_DELAY_MS=750
MAX_LOG_RANGE=2000
SCAN_ON_START=true
STATE_FILE=./data/state.json

# Transactions are disabled unless EXECUTE=true.
EXECUTE=false
KEEPER_PRIVATE_KEY=
MAX_FEE_GWEI=40
PRIORITY_FEE_GWEI=1.5
MAX_TX_COST_ETH=0.015
GAS_LIMIT_MULTIPLIER_BPS=12000
